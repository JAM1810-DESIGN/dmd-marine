// DMD Marine Consultation & Services — Prisma schema
// See docs/specs/03-database.txt (core domain) and docs/specs/09-finance-module.txt (finance).
//
// Design notes (deviations from the literal spec, documented for future reference):
// - `Role` is a plain enum on User rather than a separate dynamic `Permission` table —
//   4 fixed roles, no stated need for per-user overrides (see Phase 1 report).
// - `ServiceRequest` (03-database.txt) is not a separate model: the public "Book
//   Consultation" and per-service "Request Service" CTAs both submit to the same
//   `Booking` model, avoiding duplicate request-intake logic.
// - Project "Documents" and "Reports" (03-database.txt) share one `Document` model
//   with a `category` enum, as do Finance's four receipt/document types — one
//   upload/preview/download code path for every attachment in the system.
// - Finance's "Income" record (09-finance-module.txt) is not a separate table: its
//   fields (customer, service, booking, branch, amount, payment status/method/date)
//   are exactly `Invoice` + its `Payment`s, so `Invoice` doubles as the income ledger.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  MANAGER
  STAFF
  FINANCE_OFFICER
}

enum ContactType {
  CALL
  EMAIL
  MEETING
  SITE_VISIT
  NOTE
  OTHER
}

enum BookingStatus {
  NEW
  REVIEWING
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ScheduleType {
  CONSULTATION
  SURVEY
  INSPECTION
  TRAINING
  OTHER
}

enum ProjectStatus {
  NEW
  PLANNING
  SCHEDULED
  ACTIVE
  COMPLETED
  CLOSED
}

enum DocumentCategory {
  BOOKING_ATTACHMENT
  PROJECT_DOCUMENT
  PROJECT_REPORT
  EXPENSE_RECEIPT
  VENDOR_INVOICE
  OFFICIAL_RECEIPT
  SUPPORTING_DOCUMENT
  OTHER
}

enum MessageChannel {
  INTERNAL
  EMAIL
  FACEBOOK
}

enum NotificationType {
  NEW_INQUIRY
  NEW_BOOKING
  FACEBOOK_MESSAGE
  APPOINTMENT_REMINDER
  INVOICE_OVERDUE
  EXPENSE_PENDING_APPROVAL
  OTHER
}

enum FacebookLeadStatus {
  NEW
  CONTACTED
  CONVERTED
  CLOSED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CREDIT_CARD
  DEBIT_CARD
  GCASH
  MAYA
  CHECK
  OTHER
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  REFUNDED
  FAILED
}

enum BudgetPeriod {
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum FinancialStatementType {
  PROFIT_AND_LOSS
  BALANCE_SHEET
  CASH_FLOW
}

// ─────────────────────────────────────────────────────────────────────────────
// USER MANAGEMENT
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id           String  @id @default(cuid())
  name         String
  email        String  @unique
  passwordHash String
  role         Role    @default(STAFF)
  isActive     Boolean @default(true)
  image        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  defaultForServices  Service[]            @relation("ServiceDefaultConsultant")
  assignedBookings    Booking[]            @relation("BookingConsultant")
  assignedProjects    Project[]            @relation("ProjectConsultant")
  schedules           Schedule[]
  contactHistory      ContactHistory[]
  documentsUploaded   Document[]
  notifications       Notification[]
  messagesSent        Message[]            @relation("MessagesSent")
  messagesReceived    Message[]            @relation("MessagesReceived")
  expensesCreated     Expense[]            @relation("ExpensesCreated")
  expensesApproved    Expense[]            @relation("ExpensesApproved")
  financialStatements FinancialStatement[]
  blogPosts           BlogPost[]

  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────────
// CUSTOMER CRM
// ─────────────────────────────────────────────────────────────────────────────

model Company {
  id      String  @id @default(cuid())
  name    String
  address String?
  city    String?
  country String?
  phone   String?
  email   String?
  website String?
  notes   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customers Customer[]
  vessels   Vessel[]
  bookings  Booking[]
  projects  Project[]
  invoices  Invoice[]
  expenses  Expense[]

  @@map("companies")
}

model Customer {
  id        String  @id @default(cuid())
  name      String
  email     String?
  phone     String?
  companyId String?
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company        Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  vessels        Vessel[]
  contactHistory ContactHistory[]
  bookings       Booking[]
  projects       Project[]
  invoices       Invoice[]
  messages       Message[]
  facebookLeads  FacebookLead[]

  @@index([companyId])
  @@map("customers")
}

model Vessel {
  id         String  @id @default(cuid())
  name       String
  imoNumber  String?
  type       String?
  flag       String?
  companyId  String?
  customerId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  bookings Booking[]
  projects Project[]
  invoices Invoice[]

  @@index([companyId])
  @@index([customerId])
  @@map("vessels")
}

model ContactHistory {
  id          String      @id @default(cuid())
  customerId  String
  type        ContactType
  summary     String
  occurredAt  DateTime    @default(now())
  createdById String?

  createdAt DateTime @default(now())

  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdBy User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@map("contact_history")
}

// ─────────────────────────────────────────────────────────────────────────────
// SERVICES
// ─────────────────────────────────────────────────────────────────────────────

model ServiceCategory {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  order       Int     @default(0)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services Service[]

  @@map("service_categories")
}

model Service {
  id                  String  @id @default(cuid())
  categoryId          String
  name                String
  slug                String  @unique
  overview            String?
  benefits            String?
  scope               String?
  process             String?
  faq                 Json?
  defaultConsultantId String?
  isActive            Boolean @default(true)
  order               Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category          ServiceCategory @relation(fields: [categoryId], references: [id])
  defaultConsultant User?           @relation("ServiceDefaultConsultant", fields: [defaultConsultantId], references: [id], onDelete: SetNull)
  bookings          Booking[]
  projects          Project[]
  invoices          Invoice[]
  invoiceItems      InvoiceItem[]

  @@index([categoryId])
  @@map("services")
}

// ─────────────────────────────────────────────────────────────────────────────
// BOOKING
// ─────────────────────────────────────────────────────────────────────────────

model Booking {
  id                   String        @id @default(cuid())
  customerName         String
  customerEmail        String
  customerPhone        String?
  companyName          String?
  vesselName           String?
  port                 String?
  serviceId            String
  preferredDate        DateTime?
  preferredTime        String?
  message              String?
  status               BookingStatus @default(NEW)
  assignedConsultantId String?
  customerId           String?
  companyId            String?
  vesselId             String?
  branchId             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  service            Service    @relation(fields: [serviceId], references: [id])
  assignedConsultant User?      @relation("BookingConsultant", fields: [assignedConsultantId], references: [id], onDelete: SetNull)
  customer           Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  company            Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  vessel             Vessel?    @relation(fields: [vesselId], references: [id], onDelete: SetNull)
  branch             Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  attachments        Document[]
  schedule           Schedule?
  project            Project?
  expenses           Expense[]
  invoices           Invoice[]

  @@index([status])
  @@index([createdAt])
  @@index([serviceId])
  @@map("bookings")
}

model Schedule {
  id           String       @id @default(cuid())
  bookingId    String?      @unique
  projectId    String?
  type         ScheduleType
  title        String
  startAt      DateTime
  endAt        DateTime
  consultantId String
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking    Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  project    Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  consultant User     @relation(fields: [consultantId], references: [id])

  @@index([projectId])
  @@index([startAt])
  @@map("schedules")
}

// ─────────────────────────────────────────────────────────────────────────────
// PROJECT MANAGEMENT
// ─────────────────────────────────────────────────────────────────────────────

model Project {
  id           String        @id @default(cuid())
  name         String
  customerId   String?
  companyId    String?
  vesselId     String?
  bookingId    String?       @unique
  serviceId    String?
  consultantId String
  branchId     String?
  status       ProjectStatus @default(NEW)
  startDate    DateTime?
  endDate      DateTime?
  description  String?

  // Public website "Projects" showcase (opt-in; off by default)
  isPublic      Boolean @default(false)
  summary       String?
  coverImageUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer   Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  company    Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  vessel     Vessel?    @relation(fields: [vesselId], references: [id], onDelete: SetNull)
  booking    Booking?   @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  service    Service?   @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  consultant User       @relation("ProjectConsultant", fields: [consultantId], references: [id])
  branch     Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  documents  Document[]
  schedules  Schedule[]
  expenses   Expense[]
  invoices   Invoice[]

  @@index([status])
  @@index([customerId])
  @@index([isPublic])
  @@map("projects")
}

model Document {
  id           String           @id @default(cuid())
  fileName     String
  url          String
  mimeType     String?
  sizeBytes    Int?
  category     DocumentCategory
  bookingId    String?
  projectId    String?
  expenseId    String?
  uploadedById String?

  createdAt DateTime @default(now())

  booking    Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  project    Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  expense    Expense? @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  uploadedBy User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([projectId])
  @@index([expenseId])
  @@map("documents")
}

// ─────────────────────────────────────────────────────────────────────────────
// COMMUNICATION
// ─────────────────────────────────────────────────────────────────────────────

model Message {
  id             String         @id @default(cuid())
  channel        MessageChannel @default(INTERNAL)
  subject        String?
  body           String
  fromUserId     String?
  toUserId       String?
  customerId     String?
  facebookLeadId String?
  isRead         Boolean        @default(false)

  createdAt DateTime @default(now())

  fromUser     User?         @relation("MessagesSent", fields: [fromUserId], references: [id], onDelete: SetNull)
  toUser       User?         @relation("MessagesReceived", fields: [toUserId], references: [id], onDelete: SetNull)
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  facebookLead FacebookLead? @relation(fields: [facebookLeadId], references: [id], onDelete: SetNull)

  @@index([isRead])
  @@map("messages")
}

model Notification {
  id      String           @id @default(cuid())
  userId  String?
  type    NotificationType
  title   String
  message String
  link    String?
  isRead  Boolean          @default(false)

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model FacebookLead {
  id         String             @id @default(cuid())
  pageId     String
  // Messenger page-scoped user id — the thread identity for conversations.
  psid       String?            @unique
  // Lead Ads submission id — present when this record originated from a lead form.
  leadgenId  String?            @unique
  name       String?
  email      String?
  phone      String?
  message    String?
  status     FacebookLeadStatus @default(NEW)
  rawPayload Json?
  customerId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  messages Message[]

  @@index([status])
  @@index([customerId])
  @@map("facebook_leads")
}

// ─────────────────────────────────────────────────────────────────────────────
// BRANCHES (finance + optional cross-module scoping)
// ─────────────────────────────────────────────────────────────────────────────

model Branch {
  id       String  @id @default(cuid())
  name     String
  address  String?
  phone    String?
  email    String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings            Booking[]
  projects            Project[]
  expenses            Expense[]
  invoices            Invoice[]
  budgets             Budget[]
  financialStatements FinancialStatement[]

  @@map("branches")
}

// ─────────────────────────────────────────────────────────────────────────────
// FINANCE — Expenses
// ─────────────────────────────────────────────────────────────────────────────

model ExpenseCategory {
  id        String  @id @default(cuid())
  name      String  @unique
  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())

  expenses Expense[]
  budgets  Budget[]

  @@map("expense_categories")
}

model Vendor {
  id          String  @id @default(cuid())
  name        String
  contactName String?
  email       String?
  phone       String?
  address     String?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses Expense[]

  @@map("vendors")
}

model Expense {
  id            String        @id @default(cuid())
  expenseNumber String        @unique
  expenseDate   DateTime
  categoryId    String
  vendorId      String?
  description   String
  projectId     String?
  bookingId     String?
  branchId      String?
  amount        Decimal       @db.Decimal(12, 2)
  taxAmount     Decimal       @default(0) @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  paymentStatus ExpenseStatus @default(PENDING)
  notes         String?
  createdById   String
  approvedById  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category   ExpenseCategory @relation(fields: [categoryId], references: [id])
  vendor     Vendor?         @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  project    Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  booking    Booking?        @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  branch     Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdBy  User            @relation("ExpensesCreated", fields: [createdById], references: [id])
  approvedBy User?           @relation("ExpensesApproved", fields: [approvedById], references: [id], onDelete: SetNull)
  documents  Document[]
  company    Company?        @relation(fields: [companyId], references: [id])
  companyId  String?

  @@index([paymentStatus])
  @@index([expenseDate])
  @@index([categoryId])
  @@map("expenses")
}

// ─────────────────────────────────────────────────────────────────────────────
// FINANCE — Invoices (doubles as the income ledger) & Payments
// ─────────────────────────────────────────────────────────────────────────────

model Invoice {
  id             String        @id @default(cuid())
  invoiceNumber  String        @unique
  customerId     String?
  companyId      String?
  vesselId       String?
  serviceId      String?
  bookingId      String?
  projectId      String?
  branchId       String?
  subtotal       Decimal       @db.Decimal(12, 2)
  taxAmount      Decimal       @default(0) @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal       @db.Decimal(12, 2)
  paymentTerms   String?
  notes          String?
  status         InvoiceStatus @default(DRAFT)
  issueDate      DateTime      @default(now())
  dueDate        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  company  Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  vessel   Vessel?       @relation(fields: [vesselId], references: [id], onDelete: SetNull)
  service  Service?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  booking  Booking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  project  Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  branch   Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  items    InvoiceItem[]
  payments Payment[]

  @@index([status])
  @@index([issueDate])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  serviceId   String?
  description String
  quantity    Decimal @default(1) @db.Decimal(12, 2)
  unitPrice   Decimal @db.Decimal(12, 2)
  taxRate     Decimal @default(0) @db.Decimal(5, 2)
  lineTotal   Decimal @db.Decimal(12, 2)

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@map("invoice_items")
}

model Payment {
  id              String        @id @default(cuid())
  invoiceId       String
  paymentDate     DateTime      @default(now())
  amount          Decimal       @db.Decimal(12, 2)
  method          PaymentMethod
  status          PaymentStatus @default(COMPLETED)
  referenceNumber String?
  notes           String?

  createdAt DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("payments")
}

// ─────────────────────────────────────────────────────────────────────────────
// FINANCE — Budgets & Statements
// ─────────────────────────────────────────────────────────────────────────────

model Budget {
  id          String       @id @default(cuid())
  name        String
  categoryId  String?
  branchId    String?
  period      BudgetPeriod
  periodStart DateTime
  periodEnd   DateTime
  amount      Decimal      @db.Decimal(12, 2)
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  branch   Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([periodStart, periodEnd])
  @@map("budgets")
}

model FinancialStatement {
  id            String                 @id @default(cuid())
  type          FinancialStatementType
  periodStart   DateTime
  periodEnd     DateTime
  branchId      String?
  data          Json
  generatedById String?

  createdAt DateTime @default(now())

  branch      Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  generatedBy User?   @relation(fields: [generatedById], references: [id], onDelete: SetNull)

  @@index([type, periodStart, periodEnd])
  @@map("financial_statements")
}

// ─────────────────────────────────────────────────────────────────────────────
// PUBLIC WEBSITE
// ─────────────────────────────────────────────────────────────────────────────

model BlogPost {
  id            String    @id @default(cuid())
  title         String
  slug          String    @unique
  excerpt       String?
  content       String
  coverImageUrl String?
  authorId      String?
  isPublished   Boolean   @default(false)
  publishedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([isPublished, publishedAt])
  @@map("blog_posts")
}

model Testimonial {
  id          String  @id @default(cuid())
  authorName  String
  authorTitle String?
  company     String?
  quote       String
  rating      Int?
  avatarUrl   String?
  isPublished Boolean @default(false)
  order       Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished, order])
  @@map("testimonials")
}

model ContactSubmission {
  id      String  @id @default(cuid())
  name    String
  email   String
  phone   String?
  subject String?
  message String
  isRead  Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([isRead])
  @@map("contact_submissions")
}

/// Singleton row (id "default") holding editable site-wide contact details.
/// Left empty until the business supplies real values — never seed fake
/// phone/address/social data here.
model SiteSettings {
  id           String  @id @default("default")
  companyName  String  @default("DMD Marine Consultation & Services")
  email        String?
  phone        String?
  address      String?
  city         String?
  country      String?
  facebookUrl  String?
  linkedinUrl  String?
  instagramUrl String?
  whatsapp     String?

  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

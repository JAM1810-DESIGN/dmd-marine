# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=dmd
POSTGRES_PASSWORD=dmd_dev_password
POSTGRES_DB=dmd_marine
POSTGRES_PORT=5435
DATABASE_URL="postgresql://dmd:dmd_dev_password@localhost:5435/dmd_marine?schema=public"

# ── Auth.js ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=
NEXTAUTH_URL="http://localhost:3000"

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="DMD Marine Consultation & Services"

# ── Email (Resend) — required starting Booking/Notifications phases ───────
# RESEND_API_KEY=
# EMAIL_FROM="DMD Marine <no-reply@dmdmarine.com>"

# ── File storage (Cloudinary) — required starting Booking phase (attachments) ─
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ── Facebook Business Integration ──────────────────────────────────────────
# Register webhook callback URL in Meta App > Webhooks as:
#   {NEXT_PUBLIC_APP_URL}/api/facebook/webhook
# Subscribe to the "messages" and "leadgen" fields on your Page.
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=              # used to verify X-Hub-Signature-256 on incoming webhooks
# FACEBOOK_PAGE_ACCESS_TOKEN=       # used to send Messenger replies and fetch lead/profile data
# FACEBOOK_WEBHOOK_VERIFY_TOKEN=    # any string you choose; must match what you enter in Meta's webhook setup

# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=dmd
POSTGRES_PASSWORD=dmd_dev_password
POSTGRES_DB=dmd_marine
POSTGRES_PORT=5435
DATABASE_URL="postgresql://dmd:dmd_dev_password@localhost:5435/dmd_marine?schema=public"

# ── Auth.js ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=
NEXTAUTH_URL="http://localhost:3000"

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="DMD Marine Consultation & Services"

# ── Email (outgoing) ─────────────────────────────────────────────────────────
# Sends external message replies, invoice reminders, etc. Configure ONE transport
# (Gmail SMTP or Resend). MAIL_FROM is required for any email to send.
# MAIL_FROM="DMD Marine <dmdmarine2010@gmail.com>"
#
# Option A — Gmail SMTP (see SMTP_* block below), preferred for a gmail.com sender.
# Option B — Resend (needs a verified domain; cannot send from gmail.com):
# RESEND_API_KEY=

# ── File storage (Cloudinary) — required starting Booking phase (attachments) ─
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ── Facebook Business Integration ──────────────────────────────────────────
# Register webhook callback URL in Meta App > Webhooks as:
#   {NEXT_PUBLIC_APP_URL}/api/facebook/webhook
# Subscribe to the "messages" and "leadgen" fields on your Page.
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=              # used to verify X-Hub-Signature-256 on incoming webhooks
# FACEBOOK_PAGE_ACCESS_TOKEN=       # used to send Messenger replies and fetch lead/profile data
# FACEBOOK_WEBHOOK_VERIFY_TOKEN=    # any string you choose; must match what you enter in Meta's webhook setup

# AI assistant (draft replies + Ask AI help panel)
ANTHROPIC_API_KEY=sk-ant-...

# ── Rate limiting (optional) ─────────────────────────────────────────────────
# Shared store so limits hold across serverless instances. Create a free DB at
# upstash.com → Redis, then paste the REST URL + token. Unset = in-memory only.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Gmail SMTP for outgoing email (Option A above). Requires a Gmail App Password
# (Google account with 2-Step Verification on → App passwords). Also set MAIL_FROM.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=your-gmail-app-password
